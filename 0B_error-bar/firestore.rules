rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validBase(data) {
      return data.name is string
        && data.name.size() <= 40
        && data.pointCount is int
        && data.pointCount >= 1
        && data.pointCount <= 40
        && data.sampleCount is int
        && data.sampleCount >= 1
        && data.sampleCount <= 12
        && data.updatedAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > request.time;
    }
    function isLegacyPayload(data) {
      return data.keys().hasOnly([
          'name', 'x', 'y', 'pointCount', 'sampleCount', 'updatedAt', 'expiresAt'
        ])
        && data.x is list
        && data.y is list
        && data.x.size() <= 40
        && data.y.size() <= 480;
    }
    function isColumnMetaPayload(data) {
      return data.keys().hasOnly([
          'name', 'pointCount', 'sampleCount', 'formatVersion', 'createdAt', 'updatedAt', 'expiresAt'
        ]);
    }
    match /sharedDatasets/{code} {
      allow read: if code.matches('[A-Z0-9]{4}')
        && (!exists(/databases/$(database)/documents/sharedDatasets/$(code))
          || !resource.data.keys().hasAll(['expiresAt'])
          || resource.data.expiresAt > request.time);

      allow create: if code.matches('[A-Z0-9]{4}')
        && validBase(request.resource.data)
        && (isLegacyPayload(request.resource.data) || isColumnMetaPayload(request.resource.data));

      allow update: if code.matches('[A-Z0-9]{4}')
        && validBase(request.resource.data)
        && (isLegacyPayload(request.resource.data) || isColumnMetaPayload(request.resource.data));

      match /columns/{columnId} {
        allow read: if true;
        allow create, update: if columnId.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['x', 'y', 'updatedAt'])
          && request.resource.data.x is string
          && request.resource.data.x.size() <= 80
          && request.resource.data.y is list
          && request.resource.data.y.size() <= 12
          && request.resource.data.updatedAt is timestamp;
        allow delete: if true;
      }
    }
  }
}
